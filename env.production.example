# ==========================================
# Production Environment Configuration
# ==========================================
#
# ВАЖНО: Скопируйте этот файл как .env и заполните все значения!
# Никогда не коммитьте .env файл с реальными секретами в git!

# ==========================================
# Database Configuration
# ==========================================

# Имя базы данных PostgreSQL
POSTGRES_DB=llm_assistant_prod

# Пользователь PostgreSQL
POSTGRES_USER=llm_user_prod

# Пароль PostgreSQL
# ⚠️ ОБЯЗАТЕЛЬНО ИЗМЕНИТЬ! Используйте сильный пароль (минимум 16 символов)
# Генерация: openssl rand -base64 24
POSTGRES_PASSWORD=<STRONG_PASSWORD_HERE>

# Порт PostgreSQL (внутренний, не expose наружу)
POSTGRES_PORT=5432

# ==========================================
# Telegram Bot Configuration
# ==========================================

# Токен Telegram бота
# Получить: напишите @BotFather в Telegram, команда /newbot
# Формат: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=<YOUR_BOT_TOKEN>

# ==========================================
# OpenAI Configuration
# ==========================================

# API ключ OpenAI
# Получить: https://platform.openai.com/api-keys
# Формат: sk-...
OPENAI_API_KEY=<YOUR_OPENAI_KEY>

# URL прокси для OpenAI API (стандартный endpoint)
OPENAI_PROXY_URL=https://api.openai.com/v1

# Модель LLM для использования
# Рекомендуется: gpt-4o-mini (быстрая и дешевая)
# Альтернативы: gpt-4o, gpt-4-turbo
OPENAI_MODEL=gpt-4o-mini

# Таймаут для запросов к OpenAI (секунды)
OPENAI_TIMEOUT=60.0

# ==========================================
# API Configuration
# ==========================================

# Хост API сервера (0.0.0.0 для доступа извне)
API_HOST=0.0.0.0

# Порт API сервера (production: 8003)
API_PORT=8003

# ==========================================
# Frontend Configuration
# ==========================================

# URL API для клиентской части (браузер)
# Замените <server_address> на реальный IP/домен сервера
# ВАЖНО: Эта переменная встраивается в код при сборке образа!
# Для изменения нужно пересобрать frontend через GitHub Actions
NEXT_PUBLIC_API_URL=http://89.223.67.136:8003

# URL API для серверной части Next.js (внутри Docker)
API_HOST=http://api:8003

# ==========================================
# LLM Parameters (Optional)
# ==========================================

# Максимум итераций вызова инструментов
LLM_MAX_TOOL_ITERATIONS=10

# Максимум веб-запросов за диалог
LLM_MAX_WEBSEARCH_CALLS=2

# Максимум токенов ответа с инструментами
LLM_MAX_TOKENS_WITH_TOOLS=10000

# Максимум токенов ответа без инструментов
LLM_MAX_TOKENS_NO_TOOLS=12000

# ==========================================
# Web Search Parameters (Optional)
# ==========================================

# Количество результатов поиска по умолчанию
WEBSEARCH_DEFAULT_RESULTS=3

# Максимум результатов поиска
WEBSEARCH_MAX_RESULTS=5

# Максимальная длина описания результата
WEBSEARCH_MAX_BODY_LENGTH=200

# ==========================================
# Wikipedia Parameters (Optional)
# ==========================================

# Максимальная длина summary из Wikipedia
WIKIPEDIA_MAX_SUMMARY_LENGTH=500

# User agent для Wikipedia API
WIKIPEDIA_USER_AGENT=LLM-Assistant-Bot/1.0

# ==========================================
# System Prompt Configuration (Optional)
# ==========================================

# Путь к файлу системного промпта
# Если не указан, используется промпт по умолчанию
# SYSTEM_PROMPT_FILE=/app/prompts/default.txt

# Название роли бота
ROLE_NAME=AI Assistant

# Описание роли
ROLE_DESCRIPTION=Универсальный ИИ-ассистент

# Максимум сообщений в истории диалога
MAX_CONTEXT_MESSAGES=10

# ==========================================
# Database Connection (Auto-generated)
# ==========================================

# URL подключения к базе данных (формируется автоматически)
# Не изменяйте если используете стандартную конфигурацию Docker Compose
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Размер connection pool
DATABASE_POOL_SIZE=5

# Логировать SQL запросы (для отладки, отключить в production)
DATABASE_ECHO=false

# ==========================================
# Logging Configuration
# ==========================================

# Уровень логирования
# Варианты: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Production: INFO или WARNING
LOG_LEVEL=INFO

# ==========================================
# Checklist перед запуском:
# ==========================================
#
# [ ] POSTGRES_PASSWORD изменен на сильный пароль
# [ ] TELEGRAM_BOT_TOKEN указан (от @BotFather)
# [ ] OPENAI_API_KEY указан (от platform.openai.com)
# [ ] NEXT_PUBLIC_API_URL содержит реальный IP/домен сервера
# [ ] Файл .env НЕ закоммичен в git
# [ ] Права на файл: chmod 600 .env (только владелец может читать)

