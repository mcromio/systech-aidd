# ==================================
# LLM Assistant - Environment Variables
# ==================================
# РЎРєРѕРїРёСЂСѓР№С‚Рµ СЌС‚РѕС‚ С„Р°Р№Р» РІ .env Рё Р·Р°РїРѕР»РЅРёС‚Рµ СЃРІРѕРёРјРё Р·РЅР°С‡РµРЅРёСЏРјРё

# ==================================
# PostgreSQL Database
# ==================================
POSTGRES_DB=llm_assistant
POSTGRES_USER=llm_user
POSTGRES_PASSWORD=llm_password_dev
POSTGRES_PORT=5432

# Database URL РґР»СЏ РїСЂРёР»РѕР¶РµРЅРёР№ (Bot Рё API)
# Р¤РѕСЂРјР°С‚: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://llm_user:llm_password_dev@postgres:5432/llm_assistant

# ==================================
# OpenAI API Configuration
# ==================================
# РџРѕР»СѓС‡РёС‚Рµ API РєР»СЋС‡ РЅР° https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# РџСЂРѕРєСЃРё URL (РѕРїС†РёРѕРЅР°Р»СЊРЅРѕ, РµСЃР»Рё РёСЃРїРѕР»СЊР·СѓРµС‚Рµ РїСЂРѕРєСЃРё)
OPENAI_PROXY_URL=https://api.your-proxy.com/v1

# РњРѕРґРµР»СЊ РґР»СЏ РёСЃРїРѕР»СЊР·РѕРІР°РЅРёСЏ
OPENAI_MODEL=gpt-4o-mini

# ==================================
# Telegram Bot Configuration
# ==================================
# РџРѕР»СѓС‡РёС‚Рµ С‚РѕРєРµРЅ С‡РµСЂРµР· @BotFather РІ Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ==================================
# Bot Settings
# ==================================
# РџСѓС‚СЊ Рє С„Р°Р№Р»Сѓ СЃРёСЃС‚РµРјРЅРѕРіРѕ РїСЂРѕРјРїС‚Р°
SYSTEM_PROMPT_FILE=prompts/default.txt

# РќР°Р·РІР°РЅРёРµ СЂРѕР»Рё Р±РѕС‚Р°
ROLE_NAME=AI Assistant

# РћРїРёСЃР°РЅРёРµ СЂРѕР»Рё
ROLE_DESCRIPTION=РЈРЅРёРІРµСЂСЃР°Р»СЊРЅС‹Р№ РР-Р°СЃСЃРёСЃС‚РµРЅС‚

# РњР°РєСЃРёРјР°Р»СЊРЅРѕРµ РєРѕР»РёС‡РµСЃС‚РІРѕ СЃРѕРѕР±С‰РµРЅРёР№ РІ РєРѕРЅС‚РµРєСЃС‚Рµ
MAX_CONTEXT_MESSAGES=10

# РЈСЂРѕРІРµРЅСЊ Р»РѕРіРёСЂРѕРІР°РЅРёСЏ (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ==================================
# Frontend Configuration (Next.js)
# ==================================
# API URL РґР»СЏ Р±СЂР°СѓР·РµСЂР° (РїСѓР±Р»РёС‡РЅС‹Р№ Р°РґСЂРµСЃ)
NEXT_PUBLIC_API_URL=http://localhost:8000

# API URL РґР»СЏ Server-Side Rendering (РІРЅСѓС‚СЂРё Docker network)
API_HOST=http://api:8000

# ==================================
# Optional: PgAdmin (РµСЃР»Рё РёСЃРїРѕР»СЊР·СѓРµС‚Рµ)
# ==================================
PGADMIN_EMAIL=admin@localhost.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
